
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ALL Posts</title>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>

  <!-- HEADER -->
  <header>
    <div class="header-inner">
      <a class="logo" href="/posts">Communi<span>Q</span></a>
      <a class="add-btn" href="http://localhost:8080/posts/new">+ New Post</a>
    </div>
  </header>

  <!-- HERO -->
  <section class="hero">
    <h1>All <em>Posts</em></h1>
    <p>Explore what the community is talking about today.</p>
  </section>

  <!-- POSTS FEED -->
  <main class="feed">

    <% for(let post of posts) { %>

      <article class="post-card">

        <!-- TOP ROW: Avatar + Name + Badge -->
        <div class="card-top">
          <div class="avatar">
            <%= post.username[0] %>
          </div>
          <div class="author-info">
            <div class="author-name">@<%= post.username %></div>
            <div class="author-label">Community Member</div>
          </div>
          <span class="community-badge">Post</span>
        </div>

        <!-- POST CONTENT -->
        <p class="post-content"><%= post.content %></p>

        <!-- ACTION BUTTONS -->
        <div class="card-actions">

          <a class="btn btn-read" href="http://localhost:8080/posts/<%= post.id %>">
            Read more
          </a>

          <a class="btn btn-edit" href="http://localhost:8080/posts/<%= post.id %>/edit">
            Edit
          </a>

          <form class="delete-form" method="post" action="/posts/<%= post.id %>?_method=DELETE">
            <button class="btn btn-delete" type="submit">
              Delete
            </button>
          </form>

        </div>

      </article>

    <% } %>

  </main>

  <!-- BOTTOM DIVIDER -->
  <div class="feed-end">
    <hr>
    <span>You're all caught up</span>
    <hr>
  </div>

</body>
</html>
